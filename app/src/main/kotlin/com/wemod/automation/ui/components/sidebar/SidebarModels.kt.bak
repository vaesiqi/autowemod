package com.wemod.automation.ui.components.sidebar

import androidx.compose.material.icons.Icons
import androidx.compose.material.icons.filled.*
import androidx.compose.ui.graphics.vector.ImageVector

/**
 * 侧边栏菜单项基础接口
 */
sealed interface SidebarItem {
    val id: String
    val title: String
    val description: String
    val enabled: Boolean
    val animationDelay: Int
}

/**
 * 开关菜单项
 */
data class SwitchItem(
    override val id: String,
    override val title: String,
    override val description: String,
    val icon: ImageVector,
    val checked: Boolean,
    override val enabled: Boolean = true,
    override val animationDelay: Int = 0,
    val onToggle: () -> Unit
) : SidebarItem

/**
 * 按钮菜单项
 */
data class ButtonItem(
    override val id: String,
    override val title: String,
    override val description: String,
    val icon: ImageVector,
    override val enabled: Boolean = true,
    override val animationDelay: Int = 0,
    val onClick: () -> Unit
) : SidebarItem

/**
 * 分组菜单项
 */
data class Section(
    val id: String,
    val title: String,
    val items: List<SidebarItem>,
    val animationDelay: Int = 0
)

/**
 * 预定义侧边栏配置
 */
// 更新：app/src/main/kotlin/com/wemod/automation/ui/components/sidebar/SidebarModels.kt
// 在 SidebarConfigs 对象中添加新的配置方法

/**
 * 完整的侧边栏配置（包含悬浮窗管理）
 */
fun completeConfig(
    accessibilityEnabled: Boolean,
    overlayEnabled: Boolean,
    overlayRunning: Boolean,
    activeOverlays: List<String> = emptyList(),  // 🎯 新增：当前活动的悬浮窗
    onOpenAccessibilitySettings: () -> Unit,
    onOpenOverlaySettings: () -> Unit,
    onToggleOverlay: () -> Unit,
    onShowRunningIndicator: () -> Unit,          // 🎯 新增：显示运行指示器
    onShowScriptControl: () -> Unit,             // 🎯 新增：显示脚本控制
    onHideAllOverlays: () -> Unit,               // 🎯 新增：隐藏所有悬浮窗
    onTestClick: () -> Unit,
    onTestSwipe: () -> Unit,
    onOpenSettings: () -> Unit
): List<Section> {
    return listOf(
        // 权限控制区域
        Section(
            id = "permissions",
            title = "权限控制",
            animationDelay = 100,
            items = listOf(
                SwitchItem(
                    id = "accessibility",
                    title = "无障碍服务",
                    description = if (accessibilityEnabled) "已开启 ✓" else "未开启 ✗",
                    icon = Icons.Default.Accessibility,
                    checked = accessibilityEnabled,
                    onToggle = onOpenAccessibilitySettings,
                    animationDelay = 150
                ),
                SwitchItem(
                    id = "overlay_permission",
                    title = "悬浮窗权限",
                    description = if (overlayEnabled) "已授权 ✓" else "未授权 ✗",
                    icon = Icons.Default.Window,
                    checked = overlayEnabled,
                    onToggle = onOpenOverlaySettings,
                    animationDelay = 200
                ),
                SwitchItem(
                    id = "overlay_container",
                    title = "悬浮窗容器",
                    description = if (overlayRunning) "运行中" else "已停止",
                    icon = Icons.Default.Dashboard,
                    checked = overlayRunning,
                    enabled = overlayEnabled,
                    onToggle = onToggleOverlay,
                    animationDelay = 250
                )
            )
        ),
        
        // 🎯 新增：悬浮窗管理区域
        Section(
            id = "overlay_management",
            title = "悬浮窗管理",
            animationDelay = 300,
            items = listOf(
                // 当前悬浮窗状态显示
                InfoItem(
                    id = "overlay_status",
                    title = "当前悬浮窗",
                    description = if (activeOverlays.isEmpty()) "无活动悬浮窗" 
                                  else "${activeOverlays.size} 个活动",
                    icon = Icons.Default.Layers,
                    animationDelay = 350
                ),
                
                // 运行指示器开关
                SwitchItem(
                    id = "running_indicator",
                    title = "运行指示器",
                    description = if (activeOverlays.any { it.contains("running_indicator") }) 
                                 "显示中" else "已隐藏",
                    icon = Icons.Default.PlayArrow,
                    checked = activeOverlays.any { it.contains("running_indicator") },
                    enabled = overlayRunning,
                    onToggle = onShowRunningIndicator,
                    animationDelay = 400
                ),
                
                // 脚本控制器开关
                SwitchItem(
                    id = "script_control",
                    title = "脚本控制器",
                    description = if (activeOverlays.any { it.contains("script_control") }) 
                                 "显示中" else "已隐藏",
                    icon = Icons.Default.Gamepad,
                    checked = activeOverlays.any { it.contains("script_control") },
                    enabled = overlayRunning,
                    onToggle = onShowScriptControl,
                    animationDelay = 450
                ),
                
                // 隐藏所有按钮
                ButtonItem(
                    id = "hide_all_overlays",
                    title = "隐藏所有悬浮窗",
                    description = "关闭所有显示中的悬浮窗",
                    icon = Icons.Default.VisibilityOff,
                    enabled = activeOverlays.isNotEmpty(),
                    onClick = onHideAllOverlays,
                    animationDelay = 500
                )
            )
        ),
        
        // 功能测试区域
        Section(
            id = "test_functions",
            title = "功能测试",
            animationDelay = 550,
            items = listOf(
                ButtonItem(
                    id = "test_click",
                    title = "测试点击",
                    description = "在屏幕中心位置点击",
                    icon = Icons.Default.TouchApp,
                    onClick = onTestClick,
                    animationDelay = 600
                ),
                ButtonItem(
                    id = "test_swipe",
                    title = "测试滑动",
                    description = "从左到右滑动",
                    icon = Icons.Default.SwapHoriz,
                    onClick = onTestSwipe,
                    animationDelay = 650
                )
            )
        ),
        
        // 系统设置区域
        Section(
            id = "system_settings",
            title = "系统设置",
            animationDelay = 700,
            items = listOf(
                ButtonItem(
                    id = "permission_settings",
                    title = "权限设置",
                    description = "跳转到系统权限设置",
                    icon = Icons.Default.Security,
                    onClick = onOpenSettings,
                    animationDelay = 750
                ),
                ButtonItem(
                    id = "app_settings",
                    title = "应用设置",
                    description = "应用偏好设置（开发中）",
                    icon = Icons.Default.SettingsApplications,
                    enabled = false,
                    onClick = {},
                    animationDelay = 800
                )
            )
        )
    )
}

/**
 * 🎯 新增：信息显示项（只显示信息，不可点击）
 */
data class InfoItem(
    override val id: String,
    override val title: String,
    override val description: String,
    val icon: ImageVector,
    override val enabled: Boolean = true,
    override val animationDelay: Int = 0
) : SidebarItem
}